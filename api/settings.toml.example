[app]
name = "AgentFlow"
version = "0.1.0"
debug = false
secret_key = "change-me-to-a-random-secret-key"
algorithm = "HS256"
access_token_expire_minutes = 10080

[database]
host = "localhost"
port = 3306
user = "root"
password = "change-me"
database = "agentflow"
pool_size = 10
max_overflow = 20
echo = false

[vector_store]
type = "milvus"
dimension = 1024

# Copy to settings.toml if needed. Most settings should go in .env instead.
