# =============================================================================
# AgentFlow Environment Configuration (example)
# =============================================================================
# Usage:
#   Local:  cp .env.example .env  &&  edit values
#   Docker: cp .env.example .env  &&  docker compose up -d --build
# =============================================================================

# ==================== App / Auth ====================
APP_NAME=AgentFlow
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==================== MySQL ====================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=agentflow123
DB_NAME=agentflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DECODE_RESPONSES=true

# ==================== OSS (optional, leave empty for local uploads) ====================
OSS_PROVIDER=aliyun
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_REGION=

# ==================== Model Provider Switch ====================
# Options: dashscope | hunyuan | qianfan | zhipu
LLM_PROVIDER=dashscope

# ==================== DashScope (阿里百炼) ====================
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== Tencent Hunyuan (腾讯混元) ====================
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1

# ==================== Baidu Qianfan (百度千帆) ====================
QIANFAN_API_KEY=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# ==================== Zhipu AI (智谱AI) ====================
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ==================== LLM Chat ====================
LLM_API_KEY=your-dashscope-api-key
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_MODELS=qwen-plus

# ==================== Embedding ====================
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIM=1024
LLM_EMBEDDING_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_API_KEY=your-dashscope-api-key

# ==================== Rerank ====================
LLM_RERANK_MODEL=gte-rerank-v2

# ==================== Vector Store ====================
# Options: milvus | faiss
# Docker default uses milvus; for minimal local dev without Milvus, set faiss
VECTOR_STORE_TYPE=milvus
VECTOR_FAISS_INDEX_PATH=./data/faiss_index
VECTOR_DIMENSION=1024

# ==================== Milvus ====================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=default
MILVUS_COLLECTION=agentflow_chunks

# ==================== Neo4j (Graph RAG) ====================
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentflow123
NEO4J_DATABASE=neo4j

# ==================== Chunking ====================
DEFAULT_SPLITTER=sentence
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50

# ==================== Logging ====================
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
